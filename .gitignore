# build artefacts
*.o
*.bin
*.elf
gato64.elf
felinos.iso

# generated images
disk.img
gatofs.img
swap.img
fat32.img

# iso staging directory (only the checked-in grub config is tracked).
# eltorito.img is generated by grub-mkimage on every ISO build; a stale empty
# one left in the tree is picked up by grub-mkrescue in place of its own and
# makes the build fail with "Boot image file is empty".
iso/boot/gato.bin
iso/boot/grub/eltorito.img

# writable OVMF variable store, copied fresh by 'make run-efi'
iso/OVMF_VARS.fd
__pycache__/
