# FelinOS syscall number definitions
# Based on kernel/syscall.h from FelinOS kernel
# This patch adds FelinOS syscall numbers to musl's syscall.h
# IMPORTANT: Numbers MUST match kernel/syscall.h EXACTLY (1-based)

--- a/arch/x86_64/bits/syscall.h.in
+++ b/arch/x86_64/bits/syscall.h.in
@@ -1,5 +1,7 @@
 #ifndef _SYS_SYSCALL_H
 #define _SYS_SYSCALL_H
 
+#define __FELINOS_SYSCALL_BASE 0
+
 /* Linux syscall numbers (kept for reference) */
 #define __NR_read 0
 #define __NR_write 1
@@ -200,6 +202,170 @@
 #define __NR_pkey_mprotect 329
 #define __NR_pkey_free 330
 
+/* ===== FelinOS/Gato syscall numbers ===== */
+/* ABI: rax=number, rdi/rsi/rdx/rcx/r8/r9=args (64-bit) */
+/*      ebx/ecx/edx/esi/edi/ebp=args (32-bit compat) */
+/* MUST MATCH kernel/syscall.h EXACTLY */
+
+#define __NR_felinOS_exit           1   /* exit(code)                     */
+#define __NR_felinOS_write          2   /* write(fd, buf, len)            */
+#define __NR_felinOS_read           3   /* read(fd, buf, len)             */
+#define __NR_felinOS_open           4   /* open(path, flags)              */
+#define __NR_felinOS_close          5   /* close(fd)                      */
+#define __NR_felinOS_getpid         6   /* getpid()                       */
+#define __NR_felinOS_uptime         7   /* uptime() -> milliseconds       */
+#define __NR_felinOS_sleep          8   /* sleep(ms)                      */
+#define __NR_felinOS_sbrk           9   /* sbrk(incr) -> old break        */
+#define __NR_felinOS_yield          10  /* yield()                        */
+#define __NR_felinOS_getppid        11  /* getppid()                      */
+#define __NR_felinOS_spawn          12  /* spawn(path, argv, envp)        */
+#define __NR_felinOS_wait           13  /* wait(pid, status*)             */
+#define __NR_felinOS_kill           14  /* kill(pid, sig)                 */
+#define __NR_felinOS_lseek          15  /* lseek(fd, off, whence)         */
+#define __NR_felinOS_stat           16  /* stat(path, stat*)              */
+#define __NR_felinOS_readdir        17  /* readdir(path, idx, dirent*)    */
+#define __NR_felinOS_mkdir          18  /* mkdir(path)                    */
+#define __NR_felinOS_unlink         19  /* unlink(path)                   */
+#define __NR_felinOS_rename         20  /* rename(old, new)               */
+#define __NR_felinOS_chdir          21  /* chdir(path)                    */
+#define __NR_felinOS_getcwd         22  /* getcwd(buf, size)              */
+#define __NR_felinOS_dup            23  /* dup(fd)                        */
+#define __NR_felinOS_dup2           24  /* dup2(oldfd, newfd)             */
+#define __NR_felinOS_pipe           25  /* pipe(fds[2])                   */
+#define __NR_felinOS_time           26  /* time(t*)                       */
+#define __NR_felinOS_munmap         27  /* munmap(addr, len)              */
+#define __NR_felinOS_fork           28  /* fork()                         */
+#define __NR_felinOS_execve         29  /* execve(path, argv, envp)       */
+#define __NR_felinOS_sigaction      30  /* sigaction(sig, act, oact)      */
+#define __NR_felinOS_sigreturn      31  /* sigreturn()                    */
+#define __NR_felinOS_sigprocmask    32  /* sigprocmask(how, set, oset)    */
+#define __NR_felinOS_socket         33  /* socket(domain, type, proto)    */
+#define __NR_felinOS_bind           34  /* bind(fd, addr, len)            */
+#define __NR_felinOS_connect        35  /* connect(fd, addr, len)         */
+#define __NR_felinOS_listen         36  /* listen(fd, backlog)            */
+#define __NR_felinOS_accept         37  /* accept(fd, addr, len*)         */
+
+/* Linux-compatible syscalls */
+#define __NR_felinOS_getuid         38  /* getuid()                       */
+#define __NR_felinOS_getgid         39  /* getgid()                       */
+#define __NR_felinOS_geteuid        40  /* geteuid()                      */
+#define __NR_felinOS_getegid        41  /* getegid()                      */
+#define __NR_felinOS_setuid         42  /* setuid(uid)                    */
+#define __NR_felinOS_setgid         43  /* setgid(gid)                    */
+#define __NR_felinOS_gettid         44  /* gettid()                       */
+#define __NR_felinOS_times          45  /* times(tms*)                    */
+#define __NR_felinOS_uname          46  /* uname(utsname*)                */
+#define __NR_felinOS_getrlimit      47  /* getrlimit(res, rlim*)          */
+#define __NR_felinOS_setrlimit      48  /* setrlimit(res, rlim*)          */
+#define __NR_felinOS_getrusage      49  /* getrusage(who, usage*)         */
+#define __NR_felinOS_gettimeofday   50  /* gettimeofday(tv, tz)           */
+#define __NR_felinOS_settimeofday   51  /* settimeofday(tv, tz)           */
+#define __NR_felinOS_nanosleep      52  /* nanosleep(req, rem)            */
+#define __NR_felinOS_clock_gettime  53  /* clock_gettime(clk, ts)         */
+#define __NR_felinOS_clock_settime  54  /* clock_settime(clk, ts)         */
+#define __NR_felinOS_mmap           55  /* mmap(addr, len, prot, fl, fd, off) */
+#define __NR_felinOS_mprotect       56  /* mprotect(addr, len, prot)      */
+#define __NR_felinOS_msync          57  /* msync(addr, len, flags)        */
+#define __NR_felinOS_madvise        58  /* madvise(addr, len, advice)     */
+#define __NR_felinOS_getdents       59  /* getdents(fd, dirent*, count)   */
+#define __NR_felinOS_fcntl          60  /* fcntl(fd, cmd, arg)            */
+#define __NR_felinOS_ioctl          61  /* ioctl(fd, req, arg)            */
+#define __NR_felinOS_fsync          62  /* fsync(fd)                      */
+#define __NR_felinOS_fdatasync      63  /* fdatasync(fd)                  */
+#define __NR_felinOS_truncate       64  /* truncate(path, len)            */
+#define __NR_felinOS_ftruncate      65  /* ftruncate(fd, len)             */
+#define __NR_felinOS_fchdir         66  /* fchdir(fd)                     */
+#define __NR_felinOS_rmdir          67  /* rmdir(path)                    */
+#define __NR_felinOS_creat          68  /* creat(path, mode)              */
+#define __NR_felinOS_link           69  /* link(old, new)                 */
+#define __NR_felinOS_symlink        70  /* symlink(target, link)          */
+#define __NR_felinOS_readlink       71  /* readlink(path, buf, size)      */
+#define __NR_felinOS_chmod          72  /* chmod(path, mode)              */
+#define __NR_felinOS_fchmod         73  /* fchmod(fd, mode)               */
+#define __NR_felinOS_chown          74  /* chown(path, uid, gid)          */
+#define __NR_felinOS_fchown         75  /* fchown(fd, uid, gid)           */
+#define __NR_felinOS_lchown         76  /* lchown(path, uid, gid)         */
+#define __NR_felinOS_umask          77  /* umask(mask)                    */
+#define __NR_felinOS_getpgid        78  /* getpgid(pid)                   */
+#define __NR_felinOS_setpgid        79  /* setpgid(pid, pgid)             */
+#define __NR_felinOS_getsid         80  /* getsid(pid)                    */
+#define __NR_felinOS_setsid         81  /* setsid()                       */
+#define __NR_felinOS_getgroups      82  /* getgroups(size, list)          */
+#define __NR_felinOS_setgroups      83  /* setgroups(size, list)          */
+#define __NR_felinOS_getresuid      84  /* getresuid(ruid, euid, suid)    */
+#define __NR_felinOS_getresgid      85  /* getresgid(rgid, egid, sgid)    */
+#define __NR_felinOS_setresuid      86  /* setresuid(ruid, euid, suid)    */
+#define __NR_felinOS_setresgid      87  /* setresgid(rgid, egid, sgid)    */
+#define __NR_felinOS_send           88  /* send(fd, buf, len, flags)      */
+#define __NR_felinOS_recv           89  /* recv(fd, buf, len, flags)      */
+#define __NR_felinOS_sendto         90  /* sendto(fd, buf, len, fl, addr) */
+#define __NR_felinOS_recvfrom       91  /* recvfrom(fd, buf, len, fl, addr) */
+#define __NR_felinOS_getsockname    92  /* getsockname(fd, addr, len)     */
+#define __NR_felinOS_setsockopt     93  /* setsockopt(fd, lvl, opt, val, len) */
+#define __NR_felinOS_gethostbyname  94  /* gethostbyname(name, addr_out)  */
+#define __NR_felinOS_getifaddr      95  /* getifaddr(k_ifinfo*)           */
+#define __NR_felinOS_getifaddrs     96  /* getifaddrs(k_ifinfo*, max)     */
+
+/* FelinOS-specific syscalls (for future phases) */
+#define __NR_felinOS_vmm_op         100
+#define __NR_felinOS_pmm_op         101
+#define __NR_felinOS_sched_op       102
+
 #endif
 
