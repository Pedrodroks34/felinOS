/*
 * FelinOS Kernel - SLUB Allocator Implementation
 * ==============================================
 * Per-CPU slab allocator with NUMA awareness
 */

#include "lib/string.h"
#include "slub.h"
#include "pmm.h"
#include "vmm.h"
#include "lib/heap.h"
#include "console.h"
#include "sync.h"
#include "sched.h"  /* for num_possible_cpus, smp_processor_id */
#include "atomic.h"  /* for atomic_t */

/* Global cache list */
static LIST_HEAD(slub_caches);
static spinlock_t slub_lock = SPINLOCK_INIT("slub-lock");

/* Per-CPU data - simple array since we don't have __percpu */
static struct kmem_cache_cpu *kmem_cache_cpu[16];  /* Max 16 CPUs */

/* kmalloc caches */
struct kmem_cache *kmalloc_caches[13];
struct kmem_cache *kmalloc_caches_dma[13];

/* Boot-time fallback allocator */
static void *slub_early_alloc(size_t size) {
    void *ptr = pmm_alloc_contiguous((size + PAGE_SIZE - 1) >> PAGE_SHIFT);
    if (ptr) memset(ptr, 0, size);
    return ptr;
}

/* Calculate slab order for given object size */
static unsigned int slub_order(size_t size, size_t align, unsigned long flags) {
    unsigned int order = 0;
    size_t slab_size;
    
    while (order <= SLUB_MAX_ORDER) {
        slab_size = PAGE_SIZE << order;
        if (slab_size >= size + align && slab_size / size >= SLUB_MIN_OBJECTS)
            break;
        order++;
    }
    return order > SLUB_MAX_ORDER ? SLUB_MAX_ORDER : order;
}

/* Initialize a new slab page */
static struct page *slab_alloc_page(struct kmem_cache *s, gfp_t flags, int node) {
    unsigned int order = s->order;
    struct page *page;
    void *addr;
    
    /* Allocate pages */
    addr = pmm_alloc_contiguous(1u << order);
    if (!addr) return NULL;
    
    page = vmm_alloc(sizeof(struct page), VM_PINNED, "slab-page");
    if (!page) {
        pmm_free_contiguous(addr, 1u << order);
        return NULL;
    }
    
    memset(page, 0, sizeof(*page));
    page->flags = 1UL << PG_slab;
    atomic_set(&page->_count, 1);
    page->slab_cache = s;
    page->s_mem = addr;
    page->pages = 1u << order;
    
    /* Initialize freelist */
    size_t obj_size = s->size;
    size_t align = s->align;
    void *start = (void *)(((uintptr_t)addr + align - 1) & ~(align - 1));
    void **freelist = start;
    void *end = addr + (PAGE_SIZE << order);
    int objects = 0;
    
    void **prev = freelist;
    void *cur = start;
    while (cur + obj_size <= end) {
        objects++;
        void *next = cur + obj_size;
        if (next + obj_size > end) {
            *prev = NULL;
            break;
        }
        *prev = next;
        prev = next;
        cur = next;
    }
    
    page->freelist = start;
    page->inuse = 0;
    page->objects = objects;
    page->pobjects = objects;
    
    /* Poison objects if enabled */
    if (s->flags & SLAB_POISON) {
        for (int i = 0; i < objects; i++) {
            void *obj = start + i * obj_size;
            memset(obj, POISON_FREE, obj_size);
        }
    }
    
    return page;
}

/* Free a slab page */
static void slab_free_page(struct kmem_cache *s, struct page *page) {
    if (page->flags & (1UL << PG_slab)) {
        pmm_free_contiguous(page->s_mem, page->pages);
    }
    kfree(page);
}

/* Get per-CPU cache data */
static inline struct kmem_cache_cpu *get_cpu_slab(struct kmem_cache *s, int cpu) {
    return s->cpu_slab[cpu];
}

/* Fast path allocation */
static inline void *slab_alloc_fastpath(struct kmem_cache *s, gfp_t flags) {
    int cpu = smp_processor_id();
    struct kmem_cache_cpu *c = s->cpu_slab[cpu];
    void *obj = c->freelist;
    
    if (likely(obj)) {
        c->freelist = *(void **)obj;
        c->page->inuse++;
        c->stat[ALLOC_FASTPATH]++;
        
        if (s->flags & SLAB_POISON) {
            if (*(uint8_t *)obj != POISON_FREE) {
                kprintf("SLUB: poison corruption at %p\n", obj);
            }
            memset(obj, POISON_ALLOC, s->object_size);
        }
        return obj;
    }
    return NULL;
}

/* Slow path allocation */
static void *slab_alloc_slowpath(struct kmem_cache *s, gfp_t flags, int node) {
    int cpu = smp_processor_id();
    struct kmem_cache_cpu *c = s->cpu_slab[cpu];
    struct page *page;
    
    c->stat[ALLOC_SLOWPATH]++;
    
    /* Try to get a page from partial list */
    if (c->partial) {
        page = c->partial;
        c->partial = page->next;
        page->next = NULL;
        c->page = page;
        c->freelist = page->freelist;
        page->freelist = NULL;
        goto have_page;
    }
    
    /* Allocate new slab */
    page = slab_alloc_page(s, flags, node);
    if (!page) return NULL;
    
    c->stat[ALLOC_NEW_SLAB]++;
    
have_page:
    c->page = page;
    c->freelist = page->freelist;
    page->freelist = NULL;
    page->inuse = 1;
    
    void *obj = c->freelist;
    c->freelist = *(void **)obj;
    
    if (s->flags & SLAB_POISON) {
        memset(obj, POISON_ALLOC, s->object_size);
    }
    
    return obj;
}

/* Fast path free */
static inline void slab_free_fastpath(struct kmem_cache *s, void *obj) {
    int cpu = smp_processor_id();
    struct kmem_cache_cpu *c = s->cpu_slab[cpu];
    struct page *page = c->page;
    
    if (likely(page && (page->flags & (1UL << PG_slab)))) {
        if (s->flags & SLAB_POISON) {
            memset(obj, POISON_FREE, s->object_size);
        }
        *(void **)obj = c->freelist;
        c->freelist = obj;
        page->inuse--;
        c->stat[FREE_FASTPATH]++;
        
        /* If slab is now empty, move to partial or free */
        if (page->inuse == 0) {
            c->stat[FREE_SLAB]++;
            c->page = NULL;
            slab_free_page(s, page);
        }
        return;
    }
    
    /* Slow path */
    slab_free_slowpath(s, obj);
}

/* Slow path free */
static void slab_free_slowpath(struct kmem_cache *s, void *obj) {
    int cpu = smp_processor_id();
    struct page *page = virt_to_page(obj);
    struct kmem_cache_cpu *c = s->cpu_slab[cpu];
    
    c->stat[FREE_SLOWPATH]++;
    
    if (s->flags & SLAB_POISON) {
        memset(obj, POISON_FREE, s->object_size);
    }
    
    *(void **)obj = page->freelist;
    page->freelist = obj;
    page->inuse--;
    
    if (page->inuse == 0) {
        /* Slab empty - free it */
        c->stat[FREE_SLAB]++;
        if (c->page == page) c->page = NULL;
        slab_free_page(s, page);
    } else if (page->inuse == page->objects - 1) {
        /* Slab became partial - add to CPU partial list */
        page->next = c->partial;
        c->partial = page;
    }
}

/* kmem_cache_create implementation */
struct kmem_cache *kmem_cache_create(const char *name, size_t size, size_t align,
                                     unsigned long flags, void (*ctor)(void *obj)) {
    struct kmem_cache *s;
    unsigned int order;
    
    if (size < sizeof(void *)) size = sizeof(void *);
    if (align < __alignof__(void *)) align = __alignof__(void *);
    
    order = slub_order(size, align, flags);
    
    /* Allocate cache structure */
    s = kzalloc(sizeof(*s, GFP_KERNEL));
    if (!s) return NULL;
    
    s->size = ALIGN(size, align);
    s->object_size = size;
    s->align = align;
    s->order = order;
    s->flags = flags;
    s->ctor = ctor;
    s->name = kstrdup(name, GFP_KERNEL);
    s->cpu_partial = SLUB_CPU_PARTIAL;
    s->min_partial = SLUB_CPU_PARTIAL / 2;
    s->node = -1;
    INIT_LIST_HEAD(&s->list);
    
    /* Allocate per-CPU data */
    s->cpu_slab = alloc_percpu(struct kmem_cache_cpu);
    if (!s->cpu_slab) {
        kfree(s->name);
        kfree(s);
        return NULL;
    }
    
    /* Initialize per-CPU data */
    for_each_possible_cpu(cpu) {
        struct kmem_cache_cpu *c = &s->cpu_slab[cpu];
        memset(c, 0, sizeof(*c));
    }
    
    /* Add to global list */
    spin_lock(&slub_lock);
    list_add(&s->list, &slub_caches);
    spin_unlock(&slub_lock);
    
    kprintf("SLUB: created cache '%s' (size=%u, order=%u, align=%u)\n",
            name, s->size, order, align);
    
    return s;
}

/* kmem_cache_destroy implementation */
void kmem_cache_destroy(struct kmem_cache *s) {
    if (!s) return;
    
    /* Flush all per-CPU partial slabs */
    for_each_possible_cpu(cpu) {
        struct kmem_cache_cpu *c = s->cpu_slab[cpu];
        while (c->partial) {
            struct page *page = c->partial;
            c->partial = page->next;
            slab_free_page(s, page);
        }
        if (c->page) {
            slab_free_page(s, c->page);
            c->page = NULL;
        }
    }
    
    kfree(s->cpu_slab);
    
    spin_lock(&slub_lock);
    list_del(&s->list);
    spin_unlock(&slub_lock);
    
    kfree(s->name);
    kfree(s);
}

/* kmem_cache_alloc implementation */
void *kmem_cache_alloc(struct kmem_cache *s, gfp_t flags) {
    void *obj;
    
    preempt_disable();
    obj = slab_alloc_fastpath(s, flags);
    if (!obj) {
        obj = slab_alloc_slowpath(s, flags, -1);
    }
    preempt_enable();
    
    if (obj && s->ctor) {
        s->ctor(obj);
    }
    
    return obj;
}

/* kmem_cache_alloc_node implementation */
void *kmem_cache_alloc_node(struct kmem_cache *s, gfp_t flags, int node) {
    void *obj;
    
    preempt_disable();
    obj = slab_alloc_fastpath(s, flags);
    if (!obj) {
        obj = slab_alloc_slowpath(s, flags, node);
    }
    preempt_enable();
    
    if (obj && s->ctor) {
        s->ctor(obj);
    }
    
    return obj;
}

/* kmem_cache_free implementation */
void kmem_cache_free(struct kmem_cache *s, void *obj) {
    if (!obj) return;
    
    preempt_disable();
    slab_free_fastpath(s, obj);
    preempt_enable();
}

/* kmem_cache_free_node implementation */
void kmem_cache_free_node(struct kmem_cache *s, void *obj, int node) {
    if (!obj) return;
    
    preempt_disable();
    slab_free_fastpath(s, obj);
    preempt_enable();
}

/* Generic kmalloc */
void *kmalloc(size_t size, gfp_t flags, GFP_KERNEL) {
    if (size == 0) return NULL;
    
    unsigned int index = fls(size - 1);
    if (index > PAGE_SHIFT) index = PAGE_SHIFT;
    
    struct kmem_cache *s = kmalloc_caches[index];
    if (!s) {
        /* Fallback to page allocator for large allocations */
        if (size > PAGE_SIZE) {
            return pmm_alloc_contiguous((size + PAGE_SIZE - 1) >> PAGE_SHIFT);
        }
        return NULL;
    }
    
    return kmem_cache_alloc(s, flags);
}

void *kmalloc_node(size_t size, gfp_t flags, int node) {
    if (size == 0) return NULL;
    
    unsigned int index = fls(size - 1);
    if (index > PAGE_SHIFT) index = PAGE_SHIFT;
    
    struct kmem_cache *s = kmalloc_caches[index];
    if (!s) {
        if (size > PAGE_SIZE) {
            return pmm_alloc_contiguous((size + PAGE_SIZE - 1) >> PAGE_SHIFT);
        }
        return NULL;
    }
    
    return kmem_cache_alloc_node(s, flags, node);
}

void *kzalloc(size_t size, gfp_t flags, GFP_KERNEL) {
    void *ptr = kmalloc(size, flags, GFP_KERNEL);
    if (ptr) memset(ptr, 0, size);
    return ptr;
}

void *kzalloc_node(size_t size, gfp_t flags, int node) {
    void *ptr = kmalloc_node(size, flags, node);
    if (ptr) memset(ptr, 0, size);
    return ptr;
}

void *kmalloc_array(size_t n, size_t size, gfp_t flags, GFP_KERNEL) {
    if (n != 0 && size > SIZE_MAX / n) return NULL;
    return kmalloc(n * size, flags, GFP_KERNEL);
}

void *kcalloc(size_t n, size_t size, gfp_t flags, GFP_KERNEL) {
    if (n != 0 && size > SIZE_MAX / n) return NULL;
    return kzalloc(n * size, flags, GFP_KERNEL);
}

/* kfree implementation */
void kfree(const void *obj) {
    if (!obj) return;
    
    struct page *page = virt_to_page(obj);
    if (!page || !(page->flags & (1UL << PG_slab))) {
        /* Not a slab object - try page allocator */
        if (is_vmalloc_addr(obj)) {
            vfree(obj);
        }
        return;
    }
    
    struct kmem_cache *s = page->slab_cache;
    kmem_cache_free(s, (void *)obj);
}

void kfree_sensitive(const void *obj, size_t size) {
    if (!obj) return;
    
    /* Clear memory before freeing */
    memset((void *)obj, 0, size);
    kfree(obj);
}

/* Bulk operations */
int kmem_cache_alloc_bulk(struct kmem_cache *s, gfp_t flags, size_t n, void **obj) {
    size_t i;
    for (i = 0; i < n; i++) {
        obj[i] = kmem_cache_alloc(s, flags);
        if (!obj[i]) goto fail;
    }
    return i;

fail:
    kmem_cache_free_bulk(s, i, obj);
    return 0;
}

void kmem_cache_free_bulk(struct kmem_cache *s, size_t n, void **obj) {
    for (size_t i = 0; i < n; i++) {
        if (obj[i]) kmem_cache_free(s, obj[i]);
    }
}

/* Cache management */
int kmem_cache_shrink(struct kmem_cache *s) {
    int freed = 0;
    
    for_each_possible_cpu(cpu) {
        struct kmem_cache_cpu *c = s->cpu_slab[cpu];
        while (c->partial) {
            struct page *page = c->partial;
            c->partial = page->next;
            slab_free_page(s, page);
            freed++;
        }
    }
    
    return freed;
}

/* Early initialization */
void slub_early_init(void) {
    /* Create boot-time kmalloc caches */
    for (int i = 0; i <= PAGE_SHIFT; i++) {
        size_t size = 1u << i;
        if (size < sizeof(void *)) size = sizeof(void *);
        kmalloc_caches[i] = kmem_cache_create("kmalloc-", size, 0, 0, NULL);
    }
}

/* Full initialization */
void slub_init(void) {
    kprintf("SLUB: initialized\n");
    
    /* Create more caches for common sizes */
    struct kmem_cache *caches[] = {
        kmem_cache_create("kmalloc-96", 96, 0, 0, NULL),
        kmem_cache_create("kmalloc-192", 192, 0, 0, NULL),
        kmem_cache_create("kmalloc-256", 256, 0, 0, NULL),
        kmem_cache_create("kmalloc-512", 512, 0, 0, NULL),
        kmem_cache_create("kmalloc-1024", 1024, 0, 0, NULL),
        kmem_cache_create("kmalloc-2048", 2048, 0, 0, NULL),
        kmem_cache_create("kmalloc-4096", 4096, 0, 0, NULL),
        kmem_cache_create("kmalloc-8192", 8192, 0, 0, NULL),
    };
    
    /* Create DMA caches */
    for (int i = 0; i <= PAGE_SHIFT; i++) {
        size_t size = 1u << i;
        if (size < sizeof(void *)) size = sizeof(void *);
        kmalloc_caches_dma[i] = kmem_cache_create("dma-kmalloc-", size, 0, SLAB_CACHE_DMA, NULL);
    }
}

/* Debug functions */
void slub_debug_init(void) {
    kprintf("SLUB: debug enabled\n");
}

void slub_dump_cache(struct kmem_cache *s) {
    kprintf("Cache: %s\n", s->name);
    kprintf("  size: %u, object_size: %u, align: %u\n", s->size, s->object_size, s->align);
    kprintf("  order: %u, cpu_partial: %u\n", s->order, s->cpu_partial);
    kprintf("  alloc: fast=%lu slow=%lu\n", s->alloc_fastpath, s->alloc_slowpath);
    kprintf("  free:  fast=%lu slow=%lu\n", s->free_fastpath, s->free_slowpath);
}